// Future genuine Cranelift guest when the native compiler links Core units.
import module math from "atto.core/math";
import module hash from "atto.core/hash";
import module cell from "atto.core/cell";
pub fnc main(): int {
  if math.min_int(7, 2) != 2; do return 1; fi
  if hash.two_bytes(42, 7) != 17646; do return 2; fi
  if !cell.can_borrow_read(2, false); do return 3; fi
  return 42;
}
