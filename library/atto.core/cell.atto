// Cranelift-local Cell borrow policy, not real Cell<T>/RefCell<T> storage.
// Source predicates do NOT grant loans or atomicity; fail closed on
// unsupported mutable aliasing, lifetime escapes or thread migration.
define module cell as
  pub fnc can_borrow_read(int readers, bool writer_active): bool {
    return readers >= 0 && readers <= 65535 && !writer_active;
  }
  pub fnc can_borrow_write(int readers, bool writer_active): bool {
    return readers == 0 && !writer_active;
  }
  pub fnc readers_after_acquire(int readers, bool writer_active): int {
    if !can_borrow_read(readers, writer_active); do return -1; fi
    if readers == 65535; do return -1; fi
    return readers + 1;
  }
  pub fnc readers_after_release(int readers, bool writer_active): int {
    if readers <= 0 || readers > 65535 || writer_active; do return -1; fi
    return readers - 1;
  }
  // No references are returned: these predicates are NON-CAPABILITIES.
  // The compiler must still check aliasing, owner generation, escape and take.
  pub fnc valid_loan_state(int readers, bool writer_active): bool {
    return readers >= 0 && readers <= 65535 && (!writer_active || readers == 0);
  }
  pub fnc can_owner_read(int readers, bool writer_active): bool {
    return readers >= 0 && readers <= 65535 && !writer_active;
  }
  pub fnc can_owner_write(int readers, bool writer_active): bool {
    return readers == 0 && !writer_active;
  }
  pub fnc can_move_owner(int readers, bool writer_active): bool {
    return readers == 0 && !writer_active;
  }
  pub fnc can_suspend_unpinned(int readers, bool writer_active): bool {
    return readers == 0 && !writer_active;
  }
end
